APP_ENV=dev
SERVER_PORT=8080

DATABASE_DRIVER=sqlite
DATABASE_URL=data/dev.db

JWT_SECRET=change-me-to-a-32-byte-random-string
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=30

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.example.com/api/v1/auth/github/callback
GITHUB_APP_REDIRECT_URI=com.resdownload.android://oauth/callback
GITHUB_STATE_TTL_SECONDS=600
GITHUB_COMPLETION_CODE_TTL_SECONDS=90
GITHUB_MOCK=false

QQ_APP_ID=
QQ_ME_URL=https://graph.qq.com/oauth2.0/me
QQ_USER_INFO_URL=https://graph.qq.com/user/get_user_info

EMAIL_MODE=console
EMAIL_OTP_TTL_SECONDS=300
EMAIL_OTP_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

WEBDAV_BASE_URL=https://dav.example.com
WEBDAV_READONLY_USERNAME=readonly_user
WEBDAV_READONLY_PASSWORD=readonly_password
WEBDAV_READONLY_ROOT_PATH=/
WEBDAV_ADMIN_USERNAME=admin_user
WEBDAV_ADMIN_PASSWORD=admin_password
WEBDAV_ADMIN_ROOT_PATH=/
WEBDAV_USER_CREDENTIAL_TTL_SECONDS=3600
WEBDAV_ADMIN_CREDENTIAL_TTL_SECONDS=900

CREDENTIAL_SECRET=change-me-to-another-32-byte-random-string
UPDATE_URL_SECRET=change-me-too-32-bytes
UPDATE_URL_TTL_SECONDS=300

ALLOWED_EMAIL_DOMAINS=qq.com
ADMIN_EMAIL_DOMAINS=
USER_EMAIL_DOMAINS=qq.com

RATELIMIT_ENABLED=true
